# ==========================================================
# SMARTLINK BAPENDA PURWAKARTA - ENVIRONMENT VARIABLES
# Salin file ini menjadi .env.local untuk pengujian lokal,
# atau masukkan nilai-nilai ini di Vercel Dashboard Settings
# ==========================================================

# 1. Supabase Settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 2. Admin Security (Opsional: default admin123)
ADMIN_PASSWORD=admin123
JWT_SECRET=smartlink-bapenda-purwakarta-secret-jwt-key-2026